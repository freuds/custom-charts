      "options": {
        "orientation": "auto",
        "reduceOptions": { "calcs": ["last"], "fields": "", "values": false },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "100 * (1 - garage_local_disk_avail{volume=\"metadata\", job=\"garage-metrics\"} / garage_local_disk_total{volume=\"metadata\", job=\"garage-metrics\"})",
          "instant": true,
          "legendFormat": "{{pod}}",
          "refId": "A"
        }
      ],
      "title": "Disque metadata (%)",
