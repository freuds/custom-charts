      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(table_size{table_name=\"multipart_upload\", job=\"garage-metrics\"})", "instant": true, "legendFormat": "", "refId": "A" }
      ],
