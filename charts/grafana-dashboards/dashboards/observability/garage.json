      },
      "targets": [
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(table_size{table_name=\"object\", job=\"garage-metrics\"})", "legendFormat": "objets", "refId": "A" },
        { "datasource": { "type": "prometheus", "uid": "${datasource}" }, "expr": "max(table_size{table_name=\"bucket_v2\", job=\"garage-metrics\"})", "legendFormat": "buckets", "refId": "B" }
      ],
